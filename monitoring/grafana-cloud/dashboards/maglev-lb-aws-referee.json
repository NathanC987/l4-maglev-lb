    {
      "id": 7,
      "type": "table",
      "title": "VPC Flow Logs: what each host sent, and with what source address",
      "description": "pktsrc is the source address written in the packets; proto 47 is GRE, 6 is TCP. The LB sends only GRE, from its own address. The backends send TCP whose source is the VIP 10.200.0.10: the replies, going straight to the client.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "parse @message \"* * * * * * * * * * * * * * * * *\" as version, eni, instance, dir, srcaddr, dstaddr, pktsrc, pktdst, srcport, dstport, proto, packets, bytes, fstart, fend, action, status\n| filter dir = \"egress\" and action = \"ACCEPT\"\n| fields replace(replace(replace(replace(replace(replace(instance, \"__LB__\", \"lb\"), \"__CLIENT__\", \"client\"), \"__BE1__\", \"be1\"), \"__BE2__\", \"be2\"), \"__BE3__\", \"be3\"), \"__BE4__\", \"be4\") as host\n| stats sum(bytes) as bytes_sent, sum(packets) as packets_sent by host, proto, pktsrc\n| sort bytes_sent desc\n| limit 30",
          "logGroups": [
            {
              "arn": "__LOG_GROUP_ARN__",
              "name": "__LOG_GROUP__"
            }
          ],
          "logGroupNames": [
            "__LOG_GROUP__"
          ],
          "statsGroups": [
            "host",
            "proto",
            "pktsrc"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bytes_sent"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
