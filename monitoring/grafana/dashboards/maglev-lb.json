{
  "uid": "maglev-lb-overview",
  "title": "L4 Maglev Load Balancer",
  "description": "Client -> maglev-lb -> backends, end to end: request path traffic, LB-internal decisions (conntrack, drops), per-backend health and load distribution, and Maglev table regeneration.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "tags": ["maglev-lb", "l4-load-balancer"],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "# L4 Maglev Load Balancer\n**Request path:** clients -&gt; `maglev-lb` (Maglev consistent-hash lookup + conntrack pinning) -&gt; GRE-encapsulated to a backend -&gt; backend decapsulates and replies **directly to the client** (Direct Server Return - the LB never sees return traffic). Panels below follow that path: overview stats, client-facing traffic, LB-internal decisions, per-backend health/load, and Maglev table regeneration events."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "x": 0, "y": 5, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "time() - maglev_lb_start_time_seconds", "refId": "A", "legendFormat": "uptime" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Backends Eligible / Configured",
      "description": "Eligible = healthy, admin-enabled, and MAC-resolved (able to receive new flows). Configured = total --backend entries at startup.",
      "gridPos": { "x": 4, "y": 5, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "maglev_lb_backends_eligible", "refId": "A", "legendFormat": "eligible" },
        { "expr": "maglev_lb_backends_configured", "refId": "B", "legendFormat": "configured" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active Flows",
      "description": "Flows currently pinned in the conntrack table.",
      "gridPos": { "x": 8, "y": 5, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "maglev_lb_conntrack_active_flows", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Maglev Table Generation",
      "description": "Increments every time the lookup table is regenerated (startup, plus every backend health/admin-state change).",
      "gridPos": { "x": 12, "y": 5, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "maglev_lb_table_generation", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "RX (clients -> LB)",
      "gridPos": { "x": 16, "y": 5, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(maglev_lb_rx_packets_total[1m]))", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "TX (LB -> backends)",
      "gridPos": { "x": 20, "y": 5, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(maglev_lb_tx_packets_total[1m]))", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Client → Load Balancer",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ingress packet rate",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(maglev_lb_rx_packets_total[1m]))",
          "refId": "A",
          "legendFormat": "packets/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ingress bandwidth",
      "gridPos": { "x": 6, "y": 10, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(maglev_lb_rx_bytes_total[1m]))",
          "refId": "A",
          "legendFormat": "bytes/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Conntrack lookups: hit vs miss",
      "description": "A hit means the flow was already pinned to a backend; a miss triggers a fresh Maglev lookup. A healthy system should be dominated by hits once flows are established.",
      "gridPos": { "x": 12, "y": 10, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(maglev_lb_conntrack_lookups_total[1m]))",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "spanNulls": true,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": []
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 13,
      "type": "gauge",
      "title": "Conntrack hit ratio (5m)",
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(maglev_lb_conntrack_lookups_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(maglev_lb_conntrack_lookups_total[5m])), 1e-9)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.85 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Load Balancer Internals",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Egress packet rate (to backends)",
      "gridPos": { "x": 0, "y": 19, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(maglev_lb_tx_packets_total[1m]))",
          "refId": "A",
          "legendFormat": "packets/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Drops by reason",
      "description": "parse_error: malformed/truncated packet. no_backend: Maglev table had no eligible backend. backend_unhealthy: conntrack-pinned backend no longer in the active snapshot. conntrack_full: the flow table's pre-allocated pool is exhausted.",
      "gridPos": { "x": 6, "y": 19, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(maglev_lb_drops_total[1m]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "spanNulls": true,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Conntrack evictions/sec",
      "description": "Flows reaped for being idle past their timeout (TCP 120s, UDP 45s by default).",
      "gridPos": { "x": 12, "y": 19, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(maglev_lb_conntrack_evictions_total[1m])",
          "refId": "A",
          "legendFormat": "evictions/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Active flows over time",
      "gridPos": { "x": 18, "y": 19, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "maglev_lb_conntrack_active_flows",
          "refId": "A",
          "legendFormat": "active flows"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Backends",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 20,
      "type": "state-timeline",
      "title": "Backend health over time",
      "description": "Green = healthy, red = unhealthy, as determined by the active health checker (TCP-connect probes).",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "maglev_lb_backend_up",
          "refId": "A",
          "legendFormat": "{{backend_addr}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "custom": { "lineWidth": 0, "fillOpacity": 100 }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Per-backend packet rate (load distribution)",
      "description": "Directly visualizes the Maglev table's load split across backends - should be roughly even for equal-weight, all-healthy backends.",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (backend_addr) (rate(maglev_lb_backend_packets_total[1m]))",
          "refId": "A",
          "legendFormat": "{{backend_addr}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Per-backend bandwidth",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (backend_addr) (rate(maglev_lb_backend_bytes_total[1m]))",
          "refId": "A",
          "legendFormat": "{{backend_addr}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Per-backend active flows",
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "maglev_lb_backend_active_flows",
          "refId": "A",
          "legendFormat": "{{backend_addr}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Per-backend health-check failure rate",
      "description": "Every failed probe, not just ones that cross the unhealthy threshold - a rising rate here is an early warning even while a backend is still marked healthy (within its rise/fall tolerance).",
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (backend_addr) (rate(maglev_lb_backend_health_check_failures_total[1m]))",
          "refId": "A",
          "legendFormat": "{{backend_addr}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 25,
      "type": "row",
      "title": "Maglev Table Regeneration",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Table generation",
      "description": "Steps up every time the backend set changes (health flip, or startup). A flow already pinned in conntrack is unaffected by a regeneration.",
      "gridPos": { "x": 0, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "maglev_lb_table_generation", "refId": "A", "legendFormat": "generation" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Table regeneration duration",
      "description": "Wall-clock time to rebuild the Maglev lookup table (permutation + populate) for the most recent regeneration.",
      "gridPos": { "x": 12, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "maglev_lb_table_regen_last_microseconds",
          "refId": "A",
          "legendFormat": "last regen"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "pointSize": 6,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    }
  ]
}
